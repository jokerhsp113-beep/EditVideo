{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:science-video-editor:edit-plan:1",
  "title": "Science Video Editor edit plan v1",
  "description": "Structural contract. Also run core.mjs validation for timeline, references, anchors and review gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "status",
    "fps",
    "width",
    "height",
    "durationFrames",
    "profile",
    "intent",
    "scenes",
    "audio",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "review",
        "final"
      ]
    },
    "fps": {
      "type": "integer",
      "minimum": 1
    },
    "width": {
      "type": "integer",
      "minimum": 1
    },
    "height": {
      "type": "integer",
      "minimum": 1
    },
    "durationFrames": {
      "type": "integer",
      "minimum": 1
    },
    "profile": {
      "const": "biy-science"
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "startMs",
          "endMs"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "startMs": {
            "type": "number",
            "minimum": 0
          },
          "endMs": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "audio": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/audio"
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visual",
        "audio",
        "notes"
      ],
      "properties": {
        "visual": {
          "enum": [
            "pending",
            "passed"
          ]
        },
        "audio": {
          "enum": [
            "pending",
            "passed",
            "not-applicable"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "cue": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "frame"
          ],
          "additionalProperties": false,
          "properties": {
            "frame": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "required": [
            "anchor"
          ],
          "additionalProperties": false,
          "properties": {
            "anchor": {
              "type": "string",
              "minLength": 1
            },
            "occurrence": {
              "type": "integer",
              "minimum": 1
            },
            "offsetFrames": {
              "type": "integer"
            }
          }
        }
      ]
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "image",
            "text",
            "rect",
            "ellipse",
            "connection"
          ]
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "parentId": {
          "type": "string",
          "minLength": 1
        },
        "z": {
          "type": "number"
        },
        "rotate": {
          "type": "number"
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pivot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "fill": {
          "type": "string",
          "minLength": 1
        },
        "stroke": {
          "type": "string",
          "minLength": 1
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0
        },
        "radius": {
          "type": "number",
          "minimum": 0
        },
        "fontSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "weight": {
          "type": "number"
        },
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "fromId": {
          "type": "string",
          "minLength": 1
        },
        "toId": {
          "type": "string",
          "minLength": 1
        },
        "fromPoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "toPoint": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "image"
              }
            }
          },
          "then": {
            "required": [
              "assetId"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "text"
              }
            }
          },
          "then": {
            "required": [
              "text",
              "fontSize"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "connection"
              }
            }
          },
          "then": {
            "required": [
              "fromId",
              "toId"
            ]
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "type",
        "start",
        "durationFrames",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "move",
            "approach",
            "reject",
            "reveal",
            "emphasize",
            "rotate"
          ]
        },
        "start": {
          "$ref": "#/$defs/cue"
        },
        "durationFrames": {
          "type": "integer",
          "minimum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        "offset": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        },
        "amount": {
          "type": "number"
        },
        "ease": {
          "enum": [
            "linear",
            "smooth",
            "out"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "move",
                  "reject"
                ]
              }
            }
          },
          "then": {
            "required": [
              "to"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "approach"
              }
            }
          },
          "then": {
            "required": [
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "rotate"
              }
            }
          },
          "then": {
            "required": [
              "amount"
            ]
          }
        }
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "purpose",
        "takeaway",
        "start",
        "durationFrames",
        "holdReason",
        "layers",
        "actions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "enum": [
            "hook",
            "mechanism",
            "comparison",
            "evidence",
            "summary"
          ]
        },
        "takeaway": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "$ref": "#/$defs/cue"
        },
        "durationFrames": {
          "type": "integer",
          "minimum": 1
        },
        "holdReason": {
          "type": "string",
          "minLength": 1
        },
        "carryFrom": {
          "type": "string",
          "minLength": 1
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/layer"
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y",
                "scale"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "scale": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            "to": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "x",
                "y",
                "scale"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "scale": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            }
          }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "assetId",
        "role",
        "startFrame",
        "durationFrames",
        "gainDb",
        "fadeInFrames",
        "fadeOutFrames",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "assetId": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "voice",
            "music",
            "ambience",
            "foley",
            "accent"
          ]
        },
        "startFrame": {
          "type": "integer",
          "minimum": 0
        },
        "durationFrames": {
          "type": "integer",
          "minimum": 1
        },
        "trimBeforeFrames": {
          "type": "integer",
          "minimum": 0
        },
        "gainDb": {
          "type": "number",
          "minimum": -96,
          "maximum": 0
        },
        "fadeInFrames": {
          "type": "integer",
          "minimum": 0
        },
        "fadeOutFrames": {
          "type": "integer",
          "minimum": 0
        },
        "duckUnderVoice": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
